{
  "name": "shippusharma-skills",
  "version": "1.0.4",
  "description": "Shippu Sharma agent skills for real engineering and developers.",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@12.2.0",
  "keywords": [
    "skills",
    "agents",
    "agent-skills",
    "ai",
    "developer",
    "engineering",
    "mvp-builder",
    "project-blueprint-builder",
    "repo-impact-optimizer",
    "skill-quality-reviewer"
  ],
  "license": "MIT",
  "author": {
    "name": "Shippu Sharma",
    "email": "shippusharma00@gmail.com",
    "url": "https://github.com/shippusharma"
  },
  "contributors": [
    {
      "name": "Shippu Sharma",
      "email": "shippusharma00@gmail.com",
      "url": "https://github.com/shippusharma"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shippusharma/skills.git"
  },
  "bugs": {
    "url": "https://github.com/shippusharma/skills/issues"
  },
  "homepage": "https://github.com/shippusharma/skills#readme",
  "scripts": {
    "list-skills": "node scripts/skills.mjs list",
    "validate": "node scripts/skills.mjs validate",
    "sync-version": "node scripts/skills.mjs sync-version",
    "check": "npm run validate && npm run format-check",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "cleanup": "rm -rf node_modules .husky",
    "========================SEMVAR==============================": "",
    "semvar:init": "changeset init",
    "semvar:changeset": "changeset",
    "semvar:version": "changeset version && npm run sync-version",
    "semvar:status": "changeset status --verbose",
    "semvar:release": "changeset publish",
    "semvar:tag": "changeset tag",
    "semvar:tag:manually": "VERSION=$(node -p \"require('./package.json').version\") && git tag -a v$VERSION -m \"Release v$VERSION\" && git push origin v$VERSION"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "prettier": "^3.9.10",
    "yaml": "^2.9.1"
  },
  "skills": "./skills/"
}
