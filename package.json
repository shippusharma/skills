{
  "name": "shippusharma-skills",
  "version": "1.0.5",
  "description": "Agent skills for scoping MVPs, planning projects before code, and improving repositories and skills.",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@12.2.0",
  "keywords": [
    "skills",
    "agents",
    "agent-skills",
    "ai",
    "developer",
    "engineering",
    "mvp-builder",
    "project-blueprint-builder",
    "repo-impact-optimizer",
    "skill-quality-reviewer"
  ],
  "license": "MIT",
  "author": {
    "name": "Shippu Sharma",
    "email": "shippusharma00@gmail.com",
    "url": "https://github.com/shippusharma"
  },
  "contributors": [
    {
      "name": "Shippu Sharma",
      "email": "shippusharma00@gmail.com",
      "url": "https://github.com/shippusharma"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shippusharma/skills.git"
  },
  "bugs": {
    "url": "https://github.com/shippusharma/skills/issues"
  },
  "homepage": "https://github.com/shippusharma/skills#readme",
  "scripts": {
    "list-skills": "node scripts/skills.mjs list",
    "validate": "node scripts/skills.mjs validate",
    "sync-version": "node scripts/skills.mjs sync-version",
    "check": "npm run validate && npm run format-check",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "cleanup": "rm -rf node_modules",
    "semver:changeset": "changeset",
    "semver:status": "changeset status --verbose",
    "semver:version": "changeset version && npm run sync-version"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "prettier": "^3.9.10",
    "yaml": "^2.9.1"
  },
  "skills": "./skills/"
}
